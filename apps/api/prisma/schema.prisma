// Modelo de datos de L'Mont.
// Etapa 1: usuarios, vendedores y sesiones.
// Etapa 2: catálogo (tipos de prenda, talles, colores, productos, variantes e historial de precios).
// Etapas 3 a 8: stock, ventas, caja, clientes, cambios, promociones y reportes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  VENDEDOR
}

/// Usuario que inicia sesión en el sistema (hoy hay uno solo, compartido).
model Usuario {
  id           Int      @id @default(autoincrement())
  usuario      String   @unique
  nombre       String
  passwordHash String   @map("password_hash")
  rol          Rol      @default(ADMIN)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@map("usuarios")
}

/// Persona que atiende y vende. Se elige en cada venta, cambio y gasto.
model Vendedor {
  id              Int              @id @default(autoincrement())
  nombre          String           @unique
  activo          Boolean          @default(true)
  creadoEn        DateTime         @default(now()) @map("creado_en")
  ventas          Venta[]
  cambios         Cambio[]
  movimientosCaja MovimientoCaja[]

  @@map("vendedores")
}

/// Sesiones de login (formato de connect-pg-simple).
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

/// Tipo de prenda: Pantalones, Remeras, Chombas, Buzos, etc.
model TipoPrenda {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  activo    Boolean    @default(true)
  creadoEn  DateTime   @default(now()) @map("creado_en")
  productos Producto[]
  promocionComponentes PromocionComponente[]

  @@map("tipos_prenda")
}

/// Talle de la lista administrable. `orden` define cómo se muestran (S, M, L… / 38, 40…).
model Talle {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  orden     Int        @default(0)
  activo    Boolean    @default(true)
  creadoEn  DateTime   @default(now()) @map("creado_en")
  variantes Variante[]
  clientes  Cliente[]

  @@map("talles")
}

/// Color de la lista administrable.
model Color {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  activo    Boolean    @default(true)
  creadoEn  DateTime   @default(now()) @map("creado_en")
  variantes Variante[]

  @@map("colores")
}

/// Modelo de prenda (por ejemplo "Chino" dentro de Pantalones). Los precios son
/// los vigentes; cada cambio queda registrado en `precios_historial`.
model Producto {
  id            Int               @id @default(autoincrement())
  tipoId        Int               @map("tipo_id")
  tipo          TipoPrenda        @relation(fields: [tipoId], references: [id])
  nombre        String
  precioCompra  Decimal           @map("precio_compra") @db.Decimal(12, 2)
  precioVenta   Decimal           @map("precio_venta") @db.Decimal(12, 2)
  observaciones String?
  activo        Boolean           @default(true)
  /// ID del producto en Tienda Nube (para la sincronización de stock).
  tiendaNubeId  BigInt?           @unique @map("tienda_nube_id")
  creadoEn      DateTime          @default(now()) @map("creado_en")
  actualizadoEn DateTime          @updatedAt @map("actualizado_en")
  variantes     Variante[]
  precios       PrecioHistorial[]
  promocionComponentes PromocionComponente[]

  @@unique([tipoId, nombre])
  @@map("productos")
}

/// Combinación color + talle de un producto. Tiene su propio stock y código de barras.
model Variante {
  id                   Int               @id @default(autoincrement())
  productoId           Int               @map("producto_id")
  producto             Producto          @relation(fields: [productoId], references: [id])
  colorId              Int               @map("color_id")
  color                Color             @relation(fields: [colorId], references: [id])
  talleId              Int               @map("talle_id")
  talle                Talle             @relation(fields: [talleId], references: [id])
  codigoBarras         String?           @unique @map("codigo_barras")
  /// Nunca negativo (CHECK en la base). Se modifica solo con movimientos de stock.
  stock                Int               @default(0)
  stockMinimo          Int               @default(0) @map("stock_minimo")
  activo               Boolean           @default(true)
  /// ID de la variante en Tienda Nube (para la sincronización de stock).
  tiendaNubeVarianteId BigInt?           @unique @map("tienda_nube_variante_id")
  movimientos          MovimientoStock[]
  ingresoItems         IngresoItem[]
  ventaItems           VentaItem[]
  cambioLlevados       CambioLlevado[]
  creadoEn             DateTime          @default(now()) @map("creado_en")

  @@unique([productoId, colorId, talleId])
  @@index([colorId])
  @@index([talleId])
  @@map("variantes")
}

/// Precios de un producto a lo largo del tiempo. Se agrega una fila al crear el
/// producto y cada vez que cambia el precio de compra o de venta.
model PrecioHistorial {
  id           Int      @id @default(autoincrement())
  productoId   Int      @map("producto_id")
  producto     Producto @relation(fields: [productoId], references: [id])
  precioCompra Decimal  @map("precio_compra") @db.Decimal(12, 2)
  precioVenta  Decimal  @map("precio_venta") @db.Decimal(12, 2)
  desde        DateTime @default(now())

  @@index([productoId, desde])
  @@map("precios_historial")
}

// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------

/// Motivo de un movimiento de stock.
enum TipoMovimiento {
  CARGA_INICIAL
  INGRESO
  AJUSTE
  VENTA
  ANULACION_VENTA
  /// Prenda que el cliente trae de vuelta (cambio o devolución): suma stock.
  DEVOLUCION
  /// Prenda que el cliente se lleva en un cambio: descuenta stock.
  CAMBIO
}

/// Cada cambio de stock de una variante queda registrado acá.
model MovimientoStock {
  id              Int            @id @default(autoincrement())
  varianteId      Int            @map("variante_id")
  variante        Variante       @relation(fields: [varianteId], references: [id])
  tipo            TipoMovimiento
  /// Positivo suma stock, negativo descuenta.
  cantidad        Int
  /// Stock de la variante después del movimiento.
  stockResultante Int            @map("stock_resultante")
  /// Para ajustes: motivo y nota ("Rotura: se descosió").
  detalle         String?
  ingresoId       Int?           @map("ingreso_id")
  ingreso         Ingreso?       @relation(fields: [ingresoId], references: [id])
  ventaId         Int?           @map("venta_id")
  venta           Venta?         @relation(fields: [ventaId], references: [id])
  cambioId        Int?           @map("cambio_id")
  cambio          Cambio?        @relation(fields: [cambioId], references: [id])
  creadoEn        DateTime       @default(now()) @map("creado_en")

  @@index([varianteId, creadoEn])
  @@index([ingresoId])
  @@index([ventaId])
  @@index([cambioId])
  @@map("movimientos_stock")
}

/// Proveedor de mercadería (los pedidos se hacen por WhatsApp).
model Proveedor {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  whatsapp String?
  notas    String?
  activo   Boolean   @default(true)
  creadoEn DateTime  @default(now()) @map("creado_en")
  ingresos Ingreso[]

  @@map("proveedores")
}

/// Ingreso de mercadería (compra a un proveedor). Suma stock a cada variante.
model Ingreso {
  id            Int               @id @default(autoincrement())
  /// Día en que llegó la mercadería.
  fecha         DateTime          @db.Date
  proveedorId   Int?              @map("proveedor_id")
  proveedor     Proveedor?        @relation(fields: [proveedorId], references: [id])
  /// Suma de cantidad × costo de los ítems.
  total         Decimal           @db.Decimal(12, 2)
  /// Se pagó con plata de la caja: cuando exista Caja, cuenta como gasto.
  pagadoConCaja Boolean           @default(false) @map("pagado_con_caja")
  nota          String?
  creadoEn      DateTime          @default(now()) @map("creado_en")
  items         IngresoItem[]
  movimientos   MovimientoStock[]

  @@index([fecha])
  @@map("ingresos")
}

model IngresoItem {
  id            Int      @id @default(autoincrement())
  ingresoId     Int      @map("ingreso_id")
  ingreso       Ingreso  @relation(fields: [ingresoId], references: [id])
  varianteId    Int      @map("variante_id")
  variante      Variante @relation(fields: [varianteId], references: [id])
  cantidad      Int
  /// Costo por unidad en esta compra.
  costoUnitario Decimal  @map("costo_unitario") @db.Decimal(12, 2)

  @@unique([ingresoId, varianteId])
  @@index([varianteId])
  @@map("ingreso_items")
}

// ---------------------------------------------------------------------------
// Ventas
// ---------------------------------------------------------------------------

enum MedioPago {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
}

/// Recargo o descuento por medio de pago. Efectivo, débito y transferencia tienen un
/// solo plan (cuotas = 1); crédito puede tener uno por cantidad de cuotas.
/// porcentaje > 0 es recargo, < 0 es descuento, 0 no cambia el precio.
model PlanPago {
  id         Int       @id @default(autoincrement())
  medio      MedioPago
  cuotas     Int       @default(1)
  porcentaje Decimal   @default(0) @db.Decimal(5, 2)
  activo     Boolean   @default(true)

  @@unique([medio, cuotas])
  @@map("planes_pago")
}

model Venta {
  id              Int               @id @default(autoincrement())
  creadoEn        DateTime          @default(now()) @map("creado_en")
  vendedorId      Int?              @map("vendedor_id")
  vendedor        Vendedor?         @relation(fields: [vendedorId], references: [id])
  /// Cliente (opcional).
  clienteId       Int?              @map("cliente_id")
  cliente         Cliente?          @relation(fields: [clienteId], references: [id])
  /// Suma de cantidad × precio cobrado de los productos, menos el descuento de las promociones.
  subtotal        Decimal           @db.Decimal(12, 2)
  /// Descuento total de las promociones aplicadas.
  descuentoPromos Decimal           @default(0) @map("descuento_promos") @db.Decimal(12, 2)
  /// Lo que se cobró en total, con recargos y descuentos de los medios de pago.
  total           Decimal           @db.Decimal(12, 2)
  nota            String?
  anulada         Boolean           @default(false)
  anuladaEn       DateTime?         @map("anulada_en")
  motivoAnulacion String?           @map("motivo_anulacion")
  items           VentaItem[]
  pagos           VentaPago[]
  movimientos     MovimientoStock[]
  cambios         Cambio[]
  promociones     VentaPromocion[]

  @@index([creadoEn])
  @@index([clienteId])
  @@map("ventas")
}

model VentaItem {
  id             Int      @id @default(autoincrement())
  ventaId        Int      @map("venta_id")
  venta          Venta    @relation(fields: [ventaId], references: [id])
  varianteId     Int      @map("variante_id")
  variante       Variante @relation(fields: [varianteId], references: [id])
  cantidad       Int
  /// Precio de venta del producto en ese momento.
  precioLista    Decimal  @map("precio_lista") @db.Decimal(12, 2)
  /// Precio por unidad que se cobró (puede tener un descuento sobre el de lista).
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  /// Precio de compra en ese momento, para calcular la ganancia.
  costoUnitario  Decimal  @map("costo_unitario") @db.Decimal(12, 2)
  /// Parte del descuento de promociones que le toca a este ítem (en total, no por unidad).
  descuentoPromo Decimal  @default(0) @map("descuento_promo") @db.Decimal(12, 2)
  devoluciones   CambioDevuelto[]

  @@unique([ventaId, varianteId])
  @@index([varianteId])
  @@map("venta_items")
}

/// Cómo se pagó una venta. Puede haber varios medios en la misma venta.
model VentaPago {
  id         Int       @id @default(autoincrement())
  ventaId    Int       @map("venta_id")
  venta      Venta     @relation(fields: [ventaId], references: [id])
  medio      MedioPago
  cuotas     Int       @default(1)
  /// Parte del subtotal que se paga con este medio.
  monto      Decimal   @db.Decimal(12, 2)
  /// Porcentaje aplicado en ese momento (copiado del plan).
  porcentaje Decimal   @default(0) @db.Decimal(5, 2)
  ajuste     Decimal   @default(0) @db.Decimal(12, 2)
  /// monto + ajuste: lo que efectivamente entró.
  cobrado    Decimal   @db.Decimal(12, 2)

  @@index([ventaId])
  @@map("venta_pagos")
}

// ---------------------------------------------------------------------------
// Promociones
// ---------------------------------------------------------------------------

enum ModoPromocion {
  /// Las prendas de la promo cuestan un precio fijo (combo o "3 por $X").
  PRECIO_FIJO
  /// Lleva N, paga M (2x1, 3x2): las más baratas salen gratis.
  NXM
}

model Promocion {
  id           Int                   @id @default(autoincrement())
  nombre       String                @unique
  modo         ModoPromocion
  /// Para PRECIO_FIJO.
  precio       Decimal?              @db.Decimal(12, 2)
  /// Para NXM: cuántas paga de las que lleva.
  pagaCantidad Int?                  @map("paga_cantidad")
  /// Vigencia opcional (inclusive).
  desde        DateTime?             @db.Date
  hasta        DateTime?             @db.Date
  activo       Boolean               @default(true)
  /// Eliminada por el usuario pero usada en ventas: no se borra para no romper esas ventas, solo deja de verse.
  eliminada    Boolean               @default(false)
  creadoEn     DateTime              @default(now()) @map("creado_en")
  componentes  PromocionComponente[]
  ventas       VentaPromocion[]

  @@map("promociones")
}

/// Qué lleva la promo: N unidades de un producto, o de cualquier producto de un tipo de prenda.
model PromocionComponente {
  id          Int         @id @default(autoincrement())
  promocionId Int         @map("promocion_id")
  promocion   Promocion   @relation(fields: [promocionId], references: [id], onDelete: Cascade)
  productoId  Int?        @map("producto_id")
  producto    Producto?   @relation(fields: [productoId], references: [id])
  tipoId      Int?        @map("tipo_id")
  tipo        TipoPrenda? @relation(fields: [tipoId], references: [id])
  cantidad    Int

  @@index([promocionId])
  @@map("promocion_componentes")
}

/// Promoción aplicada en una venta (con los valores de ese momento).
model VentaPromocion {
  id           Int       @id @default(autoincrement())
  ventaId      Int       @map("venta_id")
  venta        Venta     @relation(fields: [ventaId], references: [id])
  promocionId  Int       @map("promocion_id")
  promocion    Promocion @relation(fields: [promocionId], references: [id])
  nombre       String
  /// Cuántas veces se aplicó (dos combos en la misma venta = 2).
  veces        Int
  /// Lo que costaban esas prendas sin la promo.
  precioNormal Decimal   @map("precio_normal") @db.Decimal(12, 2)
  precio       Decimal   @db.Decimal(12, 2)
  descuento    Decimal   @db.Decimal(12, 2)

  @@index([ventaId])
  @@index([promocionId])
  @@map("venta_promociones")
}

// ---------------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------------

/// Cliente del local. Es opcional en cada venta.
model Cliente {
  id       Int      @id @default(autoincrement())
  nombre   String
  /// Solo dígitos, como en proveedores.
  whatsapp String?
  notas    String?
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en")
  /// Talles que usa (de la lista administrable): puede ser M en remeras y 42 en pantalones.
  talles   Talle[]
  ventas   Venta[]

  @@index([nombre])
  @@index([whatsapp])
  @@map("clientes")
}

// ---------------------------------------------------------------------------
// Cambios y devoluciones
// ---------------------------------------------------------------------------

/// Cambio o devolución sobre una venta. Las prendas devueltas vuelven al stock y las que se
/// lleva salen del stock. Si no se lleva nada es una devolución.
model Cambio {
  id            Int               @id @default(autoincrement())
  ventaId       Int               @map("venta_id")
  venta         Venta             @relation(fields: [ventaId], references: [id])
  creadoEn      DateTime          @default(now()) @map("creado_en")
  vendedorId    Int?              @map("vendedor_id")
  vendedor      Vendedor?         @relation(fields: [vendedorId], references: [id])
  /// Valor de lo que devuelve (al precio que lo pagó).
  totalDevuelto Decimal           @map("total_devuelto") @db.Decimal(12, 2)
  /// Valor de lo que se lleva.
  totalLlevado  Decimal           @map("total_llevado") @db.Decimal(12, 2)
  /// totalLlevado − totalDevuelto: positivo paga el cliente, negativo se le reintegra.
  diferencia    Decimal           @db.Decimal(12, 2)
  nota          String?
  devueltos     CambioDevuelto[]
  llevados      CambioLlevado[]
  pagos         CambioPago[]
  movimientos   MovimientoStock[]

  @@index([ventaId])
  @@index([creadoEn])
  @@map("cambios")
}

/// Prenda que el cliente trae de vuelta. Siempre sale de un ítem de la venta original.
model CambioDevuelto {
  id             Int       @id @default(autoincrement())
  cambioId       Int       @map("cambio_id")
  cambio         Cambio    @relation(fields: [cambioId], references: [id])
  ventaItemId    Int       @map("venta_item_id")
  ventaItem      VentaItem @relation(fields: [ventaItemId], references: [id])
  cantidad       Int
  /// Precio por unidad al que se había vendido (copiado de la venta).
  precioUnitario Decimal   @map("precio_unitario") @db.Decimal(12, 2)

  @@unique([cambioId, ventaItemId])
  @@index([ventaItemId])
  @@map("cambio_devueltos")
}

/// Prenda que el cliente se lleva a cambio.
model CambioLlevado {
  id             Int      @id @default(autoincrement())
  cambioId       Int      @map("cambio_id")
  cambio         Cambio   @relation(fields: [cambioId], references: [id])
  varianteId     Int      @map("variante_id")
  variante       Variante @relation(fields: [varianteId], references: [id])
  cantidad       Int
  precioLista    Decimal  @map("precio_lista") @db.Decimal(12, 2)
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  costoUnitario  Decimal  @map("costo_unitario") @db.Decimal(12, 2)

  @@unique([cambioId, varianteId])
  @@index([varianteId])
  @@map("cambio_llevados")
}

/// Plata que se cobró (diferencia a favor del local) o se reintegró (cobrado negativo).
model CambioPago {
  id         Int       @id @default(autoincrement())
  cambioId   Int       @map("cambio_id")
  cambio     Cambio    @relation(fields: [cambioId], references: [id])
  medio      MedioPago
  cuotas     Int       @default(1)
  monto      Decimal   @db.Decimal(12, 2)
  porcentaje Decimal   @default(0) @db.Decimal(5, 2)
  ajuste     Decimal   @default(0) @db.Decimal(12, 2)
  /// Positivo: entró a la caja. Negativo: se le devolvió al cliente.
  cobrado    Decimal   @db.Decimal(12, 2)

  @@index([cambioId])
  @@map("cambio_pagos")
}

// ---------------------------------------------------------------------------
// Caja
// ---------------------------------------------------------------------------

enum TipoCaja {
  INGRESO
  GASTO
}

/// Concepto de un ingreso o gasto de caja (Alquiler, Sueldos, Retiro…). Lista administrable.
model ConceptoCaja {
  id          Int              @id @default(autoincrement())
  nombre      String
  tipo        TipoCaja
  activo      Boolean          @default(true)
  /// Solo gastos: si resta en la ganancia de Reportes. Un retiro del dueño no es un gasto del negocio.
  cuentaEnGanancia Boolean     @default(true) @map("cuenta_en_ganancia")
  movimientos MovimientoCaja[]

  @@unique([nombre, tipo])
  @@map("conceptos_caja")
}

/// Ingreso o gasto cargado a mano. Las ventas y las compras de mercadería pagadas con la
/// caja no se copian acá: la caja las lee de sus tablas.
model MovimientoCaja {
  id         Int          @id @default(autoincrement())
  fecha      DateTime     @db.Date
  tipo       TipoCaja
  conceptoId Int          @map("concepto_id")
  concepto   ConceptoCaja @relation(fields: [conceptoId], references: [id])
  monto      Decimal      @db.Decimal(12, 2)
  medio      MedioPago    @default(EFECTIVO)
  detalle    String?
  vendedorId Int?         @map("vendedor_id")
  vendedor   Vendedor?    @relation(fields: [vendedorId], references: [id])
  creadoEn   DateTime     @default(now()) @map("creado_en")

  @@index([fecha])
  @@map("movimientos_caja")
}
