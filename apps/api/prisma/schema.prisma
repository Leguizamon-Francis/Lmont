// Modelo de datos de L'Mont.
// Etapa 1: usuarios, vendedores y sesiones.
// Etapa 2: catálogo (tipos de prenda, talles, colores, productos, variantes e historial de precios).
// Stock, ventas, caja, etc. se agregan en las etapas siguientes con nuevas migraciones.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  VENDEDOR
}

/// Usuario que inicia sesión en el sistema (hoy hay uno solo, compartido).
model Usuario {
  id           Int      @id @default(autoincrement())
  usuario      String   @unique
  nombre       String
  passwordHash String   @map("password_hash")
  rol          Rol      @default(ADMIN)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@map("usuarios")
}

/// Persona que atiende y vende. Se elige en cada venta, cambio y gasto.
model Vendedor {
  id              Int              @id @default(autoincrement())
  nombre          String           @unique
  activo          Boolean          @default(true)
  creadoEn        DateTime         @default(now()) @map("creado_en")
  ventas          Venta[]
  movimientosCaja MovimientoCaja[]

  @@map("vendedores")
}

/// Sesiones de login (formato de connect-pg-simple).
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

/// Tipo de prenda: Pantalones, Remeras, Chombas, Buzos, etc.
model TipoPrenda {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  activo    Boolean    @default(true)
  creadoEn  DateTime   @default(now()) @map("creado_en")
  productos Producto[]

  @@map("tipos_prenda")
}

/// Talle de la lista administrable. `orden` define cómo se muestran (S, M, L… / 38, 40…).
model Talle {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  orden     Int        @default(0)
  activo    Boolean    @default(true)
  creadoEn  DateTime   @default(now()) @map("creado_en")
  variantes Variante[]

  @@map("talles")
}

/// Color de la lista administrable.
model Color {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  activo    Boolean    @default(true)
  creadoEn  DateTime   @default(now()) @map("creado_en")
  variantes Variante[]

  @@map("colores")
}

/// Modelo de prenda (por ejemplo "Chino" dentro de Pantalones). Los precios son
/// los vigentes; cada cambio queda registrado en `precios_historial`.
model Producto {
  id            Int               @id @default(autoincrement())
  tipoId        Int               @map("tipo_id")
  tipo          TipoPrenda        @relation(fields: [tipoId], references: [id])
  nombre        String
  precioCompra  Decimal           @map("precio_compra") @db.Decimal(12, 2)
  precioVenta   Decimal           @map("precio_venta") @db.Decimal(12, 2)
  observaciones String?
  activo        Boolean           @default(true)
  /// ID del producto en Tienda Nube (para la sincronización de stock).
  tiendaNubeId  BigInt?           @unique @map("tienda_nube_id")
  creadoEn      DateTime          @default(now()) @map("creado_en")
  actualizadoEn DateTime          @updatedAt @map("actualizado_en")
  variantes     Variante[]
  precios       PrecioHistorial[]

  @@unique([tipoId, nombre])
  @@map("productos")
}

/// Combinación color + talle de un producto. Tiene su propio stock y código de barras.
model Variante {
  id                   Int               @id @default(autoincrement())
  productoId           Int               @map("producto_id")
  producto             Producto          @relation(fields: [productoId], references: [id])
  colorId              Int               @map("color_id")
  color                Color             @relation(fields: [colorId], references: [id])
  talleId              Int               @map("talle_id")
  talle                Talle             @relation(fields: [talleId], references: [id])
  codigoBarras         String?           @unique @map("codigo_barras")
  /// Nunca negativo (CHECK en la base). Se modifica solo con movimientos de stock.
  stock                Int               @default(0)
  stockMinimo          Int               @default(0) @map("stock_minimo")
  activo               Boolean           @default(true)
  /// ID de la variante en Tienda Nube (para la sincronización de stock).
  tiendaNubeVarianteId BigInt?           @unique @map("tienda_nube_variante_id")
  movimientos          MovimientoStock[]
  ingresoItems         IngresoItem[]
  ventaItems           VentaItem[]
  creadoEn             DateTime          @default(now()) @map("creado_en")

  @@unique([productoId, colorId, talleId])
  @@index([colorId])
  @@index([talleId])
  @@map("variantes")
}

/// Precios de un producto a lo largo del tiempo. Se agrega una fila al crear el
/// producto y cada vez que cambia el precio de compra o de venta.
model PrecioHistorial {
  id           Int      @id @default(autoincrement())
  productoId   Int      @map("producto_id")
  producto     Producto @relation(fields: [productoId], references: [id])
  precioCompra Decimal  @map("precio_compra") @db.Decimal(12, 2)
  precioVenta  Decimal  @map("precio_venta") @db.Decimal(12, 2)
  desde        DateTime @default(now())

  @@index([productoId, desde])
  @@map("precios_historial")
}

// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------

/// Motivo de un movimiento de stock. Se agregan más en las próximas etapas
/// (venta, cambio, devolución).
enum TipoMovimiento {
  CARGA_INICIAL
  INGRESO
  AJUSTE
  VENTA
  ANULACION_VENTA
}

/// Cada cambio de stock de una variante queda registrado acá.
model MovimientoStock {
  id              Int            @id @default(autoincrement())
  varianteId      Int            @map("variante_id")
  variante        Variante       @relation(fields: [varianteId], references: [id])
  tipo            TipoMovimiento
  /// Positivo suma stock, negativo descuenta.
  cantidad        Int
  /// Stock de la variante después del movimiento.
  stockResultante Int            @map("stock_resultante")
  /// Para ajustes: motivo y nota ("Rotura: se descosió").
  detalle         String?
  ingresoId       Int?           @map("ingreso_id")
  ingreso         Ingreso?       @relation(fields: [ingresoId], references: [id])
  ventaId         Int?           @map("venta_id")
  venta           Venta?         @relation(fields: [ventaId], references: [id])
  creadoEn        DateTime       @default(now()) @map("creado_en")

  @@index([varianteId, creadoEn])
  @@index([ingresoId])
  @@index([ventaId])
  @@map("movimientos_stock")
}

/// Proveedor de mercadería (los pedidos se hacen por WhatsApp).
model Proveedor {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  whatsapp String?
  notas    String?
  activo   Boolean   @default(true)
  creadoEn DateTime  @default(now()) @map("creado_en")
  ingresos Ingreso[]

  @@map("proveedores")
}

/// Ingreso de mercadería (compra a un proveedor). Suma stock a cada variante.
model Ingreso {
  id            Int               @id @default(autoincrement())
  /// Día en que llegó la mercadería.
  fecha         DateTime          @db.Date
  proveedorId   Int?              @map("proveedor_id")
  proveedor     Proveedor?        @relation(fields: [proveedorId], references: [id])
  /// Suma de cantidad × costo de los ítems.
  total         Decimal           @db.Decimal(12, 2)
  /// Se pagó con plata de la caja: cuando exista Caja, cuenta como gasto.
  pagadoConCaja Boolean           @default(false) @map("pagado_con_caja")
  nota          String?
  creadoEn      DateTime          @default(now()) @map("creado_en")
  items         IngresoItem[]
  movimientos   MovimientoStock[]

  @@index([fecha])
  @@map("ingresos")
}

model IngresoItem {
  id            Int      @id @default(autoincrement())
  ingresoId     Int      @map("ingreso_id")
  ingreso       Ingreso  @relation(fields: [ingresoId], references: [id])
  varianteId    Int      @map("variante_id")
  variante      Variante @relation(fields: [varianteId], references: [id])
  cantidad      Int
  /// Costo por unidad en esta compra.
  costoUnitario Decimal  @map("costo_unitario") @db.Decimal(12, 2)

  @@unique([ingresoId, varianteId])
  @@index([varianteId])
  @@map("ingreso_items")
}

// ---------------------------------------------------------------------------
// Ventas
// ---------------------------------------------------------------------------

enum MedioPago {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
}

/// Recargo o descuento por medio de pago. Efectivo, débito y transferencia tienen un
/// solo plan (cuotas = 1); crédito puede tener uno por cantidad de cuotas.
/// porcentaje > 0 es recargo, < 0 es descuento, 0 no cambia el precio.
model PlanPago {
  id         Int       @id @default(autoincrement())
  medio      MedioPago
  cuotas     Int       @default(1)
  porcentaje Decimal   @default(0) @db.Decimal(5, 2)
  activo     Boolean   @default(true)

  @@unique([medio, cuotas])
  @@map("planes_pago")
}

model Venta {
  id              Int               @id @default(autoincrement())
  creadoEn        DateTime          @default(now()) @map("creado_en")
  vendedorId      Int?              @map("vendedor_id")
  vendedor        Vendedor?         @relation(fields: [vendedorId], references: [id])
  /// Suma de cantidad × precio cobrado de los productos.
  subtotal        Decimal           @db.Decimal(12, 2)
  /// Lo que se cobró en total, con recargos y descuentos de los medios de pago.
  total           Decimal           @db.Decimal(12, 2)
  nota            String?
  anulada         Boolean           @default(false)
  anuladaEn       DateTime?         @map("anulada_en")
  motivoAnulacion String?           @map("motivo_anulacion")
  items           VentaItem[]
  pagos           VentaPago[]
  movimientos     MovimientoStock[]

  @@index([creadoEn])
  @@map("ventas")
}

model VentaItem {
  id             Int      @id @default(autoincrement())
  ventaId        Int      @map("venta_id")
  venta          Venta    @relation(fields: [ventaId], references: [id])
  varianteId     Int      @map("variante_id")
  variante       Variante @relation(fields: [varianteId], references: [id])
  cantidad       Int
  /// Precio de venta del producto en ese momento.
  precioLista    Decimal  @map("precio_lista") @db.Decimal(12, 2)
  /// Precio por unidad que se cobró (puede tener un descuento sobre el de lista).
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  /// Precio de compra en ese momento, para calcular la ganancia.
  costoUnitario  Decimal  @map("costo_unitario") @db.Decimal(12, 2)

  @@unique([ventaId, varianteId])
  @@index([varianteId])
  @@map("venta_items")
}

/// Cómo se pagó una venta. Puede haber varios medios en la misma venta.
model VentaPago {
  id         Int       @id @default(autoincrement())
  ventaId    Int       @map("venta_id")
  venta      Venta     @relation(fields: [ventaId], references: [id])
  medio      MedioPago
  cuotas     Int       @default(1)
  /// Parte del subtotal que se paga con este medio.
  monto      Decimal   @db.Decimal(12, 2)
  /// Porcentaje aplicado en ese momento (copiado del plan).
  porcentaje Decimal   @default(0) @db.Decimal(5, 2)
  ajuste     Decimal   @default(0) @db.Decimal(12, 2)
  /// monto + ajuste: lo que efectivamente entró.
  cobrado    Decimal   @db.Decimal(12, 2)

  @@index([ventaId])
  @@map("venta_pagos")
}

// ---------------------------------------------------------------------------
// Caja
// ---------------------------------------------------------------------------

enum TipoCaja {
  INGRESO
  GASTO
}

/// Concepto de un ingreso o gasto de caja (Alquiler, Sueldos, Retiro…). Lista administrable.
model ConceptoCaja {
  id          Int              @id @default(autoincrement())
  nombre      String
  tipo        TipoCaja
  activo      Boolean          @default(true)
  movimientos MovimientoCaja[]

  @@unique([nombre, tipo])
  @@map("conceptos_caja")
}

/// Ingreso o gasto cargado a mano. Las ventas y las compras de mercadería pagadas con la
/// caja no se copian acá: la caja las lee de sus tablas.
model MovimientoCaja {
  id         Int          @id @default(autoincrement())
  fecha      DateTime     @db.Date
  tipo       TipoCaja
  conceptoId Int          @map("concepto_id")
  concepto   ConceptoCaja @relation(fields: [conceptoId], references: [id])
  monto      Decimal      @db.Decimal(12, 2)
  medio      MedioPago    @default(EFECTIVO)
  detalle    String?
  vendedorId Int?         @map("vendedor_id")
  vendedor   Vendedor?    @relation(fields: [vendedorId], references: [id])
  creadoEn   DateTime     @default(now()) @map("creado_en")

  @@index([fecha])
  @@map("movimientos_caja")
}
